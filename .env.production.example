# Copy to .env.production and replace ALL placeholder values.
APP_ENV=production
POSTGRES_DB=yatranook
POSTGRES_USER=yatranook
# Use URL-safe hex: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=REPLACE_WITH_48_OR_MORE_HEX_CHARACTERS
# Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_OR_MORE_HEX_CHARACTERS
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.example.com
CORS_ORIGINS=
EDGE_NETWORK=edge
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1536
OSRM_BASE_URL=
LOG_LEVEL=INFO
