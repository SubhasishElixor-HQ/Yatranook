# Copy this file to .env and replace every development-only secret before deployment.
APP_ENV=development
WEB_PORT=8080
POSTGRES_DB=yatranook
POSTGRES_USER=yatranook
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
JWT_SECRET=dev-only-change-this-secret-before-deployment-000000000000
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Ollama AI provider. If Ollama is unavailable, the assistant uses a deterministic fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1536

# Optional OSRM-compatible routing endpoint. Leave empty to return geographic-order preview only.
OSRM_BASE_URL=
LOG_LEVEL=INFO
