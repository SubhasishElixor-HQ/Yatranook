# Copy this file to .env and add your own Gemini API key.
# Get a key from Google AI Studio. Never commit your real .env file.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Local paths are relative to this project folder.
RAG_DATA_DIR=rag/data/raw
RAG_CHROMA_DIR=rag/chroma_db
RAG_COLLECTION=odisha_tourism
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
